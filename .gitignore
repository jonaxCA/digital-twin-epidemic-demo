# =============================================================================
# EPIDEMIA — Sistema Monolítico v0.1
# Lo que NUNCA debe subirse al repositorio.
# =============================================================================

# --- Secretos y configuración local ------------------------------------------
# .env trae DATABASE_URL (con contraseña) y JWT_SECRET_KEY. Solo se sube la
# plantilla .env.example, sin valores reales.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credenciales*.json
service-account*.json
secrets/

# Túneles / despliegue
ngrok.yml
.ngrok2/

# --- Respaldos de base de datos ----------------------------------------------
# Un pg_dump de una base en uso puede traer usuarios, hashes y casos reales.
# El esquema versionado vive en db/ y ese SÍ se sube.
*.dump
*.backup
*.bak
pg_dump_*.sql
respaldo*/
respaldos/
backups/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# --- Archivo local -----------------------------------------------------------
# Pipeline y fuentes geográficas superadas (incluye un geojson de ~9 MB).
# Se conservan en disco, pero no forman parte del proyecto.
archivo/

# Descargas completas de INEGI (el zip del Marco Geoestadístico pesa ~98 MB);
# del repositorio solo se usa la capa data/geo/inegi_mg2024/19mun.*
data/geo/**/*.zip

# --- Logs y salidas temporales -----------------------------------------------
*.log
logs/
tmp/

# --- Editores y sistema operativo --------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini